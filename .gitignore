# Configuration réelle d'un déploiement : dérivée de
# config/config.example.yaml, elle porte des choix locaux et ne doit pas être
# versionnée. Les secrets, eux, ne figurent dans aucun des deux : ils sont
# référencés par ${VARIABLE} et lus dans l'environnement.
/config/config.yaml
/config/config.env

# Variables d'environnement du déploiement local (lues par compose.yaml).
.env

# Données d'exécution : bases SQLite, index de mémoire, session Courier.
/data/

# Dépendances vendorisées : 85 Mio générés à la demande par `make
# dokku-deploy`, qui les ajoute au seul commit poussé vers Dokku (git add -f).
# Elles n'ont rien à faire dans l'historique.
/vendor/

# Outils de développement installés localement (modd).
/tools/
/local/
*.log 
# Espace de travail local pour itérer sur un dépôt frère avant publication
# (jamais versionné) : la règle reste qu'un clone nu compile seul, donc
# go.mod ne porte aucun replace.
/go.work
/go.work.sum
/bin
# Binaires de plugins compilés localement (make build-plugins les range dans local/plugins/)
plugins/email/email
plugins/pages/pages
