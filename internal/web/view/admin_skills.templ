package view

// Bibliothèque de compétences : les modes opératoires que les agents
// chargent à la demande (voir docs/skills.md). La liste montre le
// catalogue tel que les agents le voient ; le formulaire porte le corps
// markdown, qui part au modèle — d'où l'avertissement sur la langue.

// SkillRow est une ligne de la liste.
type SkillRow struct {
	Name        string
	Description string
	// Agents : ciblage affiché tel quel (« workspace, research ») ; vide
	// signifie « tous les agents ».
	Agents    string
	Enabled   bool
	Builtin   bool
	UpdatedAt string
}

type SkillsPage struct {
	Platforms []SidebarPlatform
	CSRFToken string

	Skills []SkillRow
}

templ AdminSkills(page SkillsPage) {
	@AdminLayout("Compétences — Automata Admin", "skills", page.Platforms, page.CSRFToken) {
		<header class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-line-2 bg-white px-4 py-4 md:px-7 md:py-5.5">
			<div>
				<h1 class="text-[21px] font-semibold leading-tight tracking-[-.01em] text-ink">Compétences</h1>
				<div class="mt-0.5 text-sm text-text-3">Les modes opératoires que les agents chargent à la demande</div>
			</div>
			<a href="/admin/skills/new" class="flex h-9 shrink-0 items-center whitespace-nowrap rounded-lg bg-brand px-4 text-sm font-semibold text-white sm:ml-auto hover:bg-brand-strong hover:no-underline">Nouvelle compétence</a>
		</header>
		<div class="p-4 md:p-7">
			if len(page.Skills) == 0 {
				<div class="rounded-[11px] border border-dashed border-line bg-white px-8 py-14 text-center text-sm text-text-4">
					Aucune compétence. Les compétences fournies par le projet sont semées au démarrage du service.
				</div>
			} else {
				<div class="overflow-x-auto rounded-[11px] border border-line-2 bg-white">
					<div class="grid min-w-[720px] grid-cols-[1.2fr_2fr_.9fr_.6fr_.6fr] gap-4 border-b border-line-2 bg-panel px-5 py-2.5 font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">
						<div>Nom</div>
						<div>Description</div>
						<div>Agents ciblés</div>
						<div>État</div>
						<div class="text-right">Modifiée</div>
					</div>
					for _, row := range page.Skills {
						<a href={ templ.SafeURL("/admin/skills/" + row.Name) } class="grid min-w-[720px] grid-cols-[1.2fr_2fr_.9fr_.6fr_.6fr] items-center gap-4 border-b border-line-3 px-5 py-3.5 last:border-b-0 hover:bg-panel hover:no-underline">
							<div class="flex items-center gap-2">
								<span class="font-mono text-sm font-medium text-text">{ row.Name }</span>
								if row.Builtin {
									@StatusChip(Chip{Label: "Fournie", Tone: "brand"})
								}
							</div>
							<div class="text-[13px] leading-snug text-text-3">{ row.Description }</div>
							<div class="text-[13px] text-text-4">
								if row.Agents == "" {
									Tous
								} else {
									{ row.Agents }
								}
							</div>
							<div>
								if row.Enabled {
									@StatusChip(Chip{Label: "Active", Tone: "ok"})
								} else {
									@StatusChip(Chip{Label: "Inactive", Tone: "warn"})
								}
							</div>
							<div class="text-right font-mono text-[13px] text-text-4">{ row.UpdatedAt }</div>
						</a>
					}
				</div>
				<div class="mt-3.5 text-[13px] text-text-4">Les agents ne voient en permanence que le nom et la description ; le contenu complet n'est chargé que lorsqu'ils appellent load_skill.</div>
			}
		</div>
	}
}

// SkillFormPage sert à la fois la création (New) et l'édition. Le nom
// n'est modifiable qu'à la création : c'est la clé de la compétence.
type SkillFormPage struct {
	Platforms []SidebarPlatform
	CSRFToken string

	New         bool
	Name        string
	Description string
	Content     string
	Agents      string
	Enabled     bool
	Builtin     bool
	Edited      bool
	Saved       bool
	Error       string
}

templ AdminSkillForm(page SkillFormPage) {
	@AdminLayout("Compétence — Automata Admin", "skills", page.Platforms, page.CSRFToken) {
		<header class="border-b border-line-2 bg-white px-4 py-4 md:px-7 md:py-5.5">
			<div class="mb-2 text-[13px] text-text-4">
				<a href="/admin/skills">Compétences</a> /
				if page.New {
					<span class="text-text">Nouvelle compétence</span>
				} else {
					<span class="text-text">{ page.Name }</span>
				}
			</div>
			<h1 class="text-[21px] font-semibold leading-tight tracking-[-.01em] text-ink">
				if page.New {
					Nouvelle compétence
				} else {
					{ page.Name }
				}
			</h1>
		</header>
		<div class="flex flex-col gap-5 p-4 md:p-7">
			<form method="post" action={ skillFormAction(page) } class="flex max-w-[840px] flex-col gap-4 rounded-[11px] border border-line-2 bg-white p-5.5">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				if page.Error != "" {
					<div class="rounded-lg bg-crit-wash px-3 py-2.5 text-[13px] text-crit-deep">{ page.Error }</div>
				}
				if page.Saved {
					<div class="rounded-lg bg-ok-wash px-3 py-2.5 text-[13px] text-ok-deep">Enregistré.</div>
				}
				<div class="rounded-lg bg-warn-wash px-3 py-2.5 text-[13px] text-warn-deep">
					Le contenu part au modèle : rédigez-le en anglais.
				</div>
				if page.New {
					<label class="block">
						<span class="mb-1.5 block text-[13px] font-medium text-text-2">Nom <span class="font-normal text-text-4">— kebab-case, définitif</span></span>
						<input type="text" name="name" required value={ page.Name } placeholder="mask-logo-in-image"
							class="h-[38px] w-full rounded-lg border border-line px-3 font-mono text-sm outline-none placeholder:text-text-5 focus:border-brand"/>
					</label>
				}
				<label class="block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Description <span class="font-normal text-text-4">— une phrase, en anglais : c'est la ligne du catalogue</span></span>
					<input type="text" name="description" required value={ page.Description }
						class="h-[38px] w-full rounded-lg border border-line px-3 text-sm outline-none focus:border-brand"/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Agents ciblés <span class="font-normal text-text-4">— noms séparés par des virgules ; vide = tous les agents</span></span>
					<input type="text" name="agents" value={ page.Agents } placeholder="workspace"
						class="h-[38px] w-full rounded-lg border border-line px-3 font-mono text-sm outline-none placeholder:text-text-5 focus:border-brand"/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Contenu <span class="font-normal text-text-4">— markdown, en anglais</span></span>
					<textarea name="content" required rows="22"
						class="w-full rounded-lg border border-line px-3 py-2.5 font-mono text-[13px] leading-relaxed outline-none focus:border-brand">{ page.Content }</textarea>
				</label>
				<label class="flex items-center gap-2.5">
					<input type="checkbox" name="enabled" value="1" checked?={ page.Enabled || page.New } class="h-4 w-4 accent-brand"/>
					<span class="text-[13px] font-medium text-text-2">Active <span class="font-normal text-text-4">— une compétence inactive disparaît du catalogue des agents</span></span>
				</label>
				<div class="flex gap-2.5 border-t border-line-3 pt-4">
					<a href="/admin/skills" class="flex h-[38px] items-center justify-center rounded-lg border border-line px-4 text-sm font-medium text-text hover:bg-panel hover:no-underline">Annuler</a>
					<button type="submit" class="h-[38px] rounded-lg bg-brand px-5 text-sm font-semibold text-white hover:bg-brand-strong">Enregistrer</button>
				</div>
			</form>
			if !page.New {
				<div class="flex max-w-[840px] flex-col gap-3 rounded-[11px] border border-line-2 bg-white p-5.5">
					if page.Builtin {
						<form method="post" action={ templ.SafeURL("/admin/skills/" + page.Name + "/restore") } class="flex items-center gap-3">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<button type="submit" class="h-9 rounded-lg border border-line bg-white px-3.5 text-[13px] font-medium text-text hover:bg-bg">Restaurer la version d'origine</button>
							if page.Edited {
								<span class="text-[13px] text-text-4">Vos modifications figent cette compétence : elle ne suit plus les mises à jour du projet. Restaurer la remet à la version fournie et lève ce gel.</span>
							} else {
								<span class="text-[13px] text-text-4">Non modifiée : elle suit les mises à jour du projet à chaque déploiement.</span>
							}
						</form>
					}
					<form method="post" action={ templ.SafeURL("/admin/skills/" + page.Name + "/delete") } class="flex items-center gap-3"
						onsubmit="return confirm('Supprimer cette compétence ?')">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<button type="submit" class="h-9 rounded-lg border border-line bg-white px-3.5 text-[13px] font-medium text-crit-deep hover:bg-crit-wash">Supprimer</button>
						if page.Builtin {
							<span class="text-[13px] text-text-4">Fournie par le projet : elle sera re-semée au prochain démarrage du service.</span>
						}
					</form>
				</div>
			}
		</div>
	}
}

// skillFormAction : la création poste sur la collection, l'édition sur la
// compétence elle-même.
func skillFormAction(page SkillFormPage) templ.SafeURL {
	if page.New {
		return templ.SafeURL("/admin/skills")
	}
	return templ.SafeURL("/admin/skills/" + page.Name)
}
