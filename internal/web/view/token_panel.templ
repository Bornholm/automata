package view

// Le moment « jeton » (annotation ADM-04) : un encart pleine largeur en
// fond sombre — pas de modale à fermer, donc pas de code perdu par
// mégarde. Solennel par l'inversion de contraste et le groupement en
// quatre blocs de quatre caractères (lisible à voix haute) ; pas d'icône
// d'avertissement ni de rouge — « Régénérer » reste disponible, rien n'est
// irréversible. Partagé par le jeton personnel (ADM-04) et le jeton de
// groupe (ADM-03/05).

type TokenPanelData struct {
	// Eyebrow : « JETON PERSONNEL DE LIAISON » / « JETON DE GROUPE ».
	Eyebrow string
	// Display est le jeton groupé pour l'affichage :
	// « atm_lk7Q · 3FDR · 92MZ · X4KE ».
	Display string
	// Clipboard est le jeton brut copié tel quel.
	Clipboard string
	// Help est la consigne de transmission, adaptée au destinataire.
	Help string
	// Lifecycle décrit le cycle de vie ; Expires est l'échéance affichée
	// à côté de « En attente ».
	Expires string
	// RegenerateAction / RevokeAction : cibles des deux boutons ; vides,
	// les boutons ne sont pas rendus (jeton de groupe fraîchement créé).
	RegenerateAction string
	RevokeAction     string
	CSRFToken        string
	// Status : pending | used | expired | revoked — l'étape mise en
	// évidence dans le cycle de vie.
	Status string
}

templ tokenLifecycleStep(label string, active bool, detail string) {
	<div class="flex items-center gap-2.5">
		if active {
			<span class="size-[7px] rounded-full bg-brand-soft"></span>
			<span class="text-sm font-semibold text-white">{ label }</span>
		} else {
			<span class="size-[7px] rounded-full bg-ink-3"></span>
			<span class="text-sm text-sidebar-muted">{ label }</span>
		}
		if detail != "" {
			<span class="ml-auto font-mono text-xs text-sidebar-muted">{ detail }</span>
		}
	</div>
}

templ TokenPanel(data TokenPanelData) {
	<div class="flex items-center gap-7 rounded-xl bg-ink px-7 py-6">
		<div class="min-w-0 flex-1">
			<div class="mb-3.5 flex items-center gap-2.5">
				@Eyebrow(data.Eyebrow, "text-brand-soft")
				if data.Display != "" {
					<span class="rounded-full bg-brand-soft px-2 py-0.5 text-[11px] font-semibold text-ink">Visible une seule fois</span>
				}
			</div>
			if data.Display != "" {
				<div class="flex items-stretch gap-2.5">
					<div class="min-w-0 flex-1 break-all rounded-[10px] border border-ink-3 bg-[#0D1117] px-4.5 py-4 font-mono text-[22px] font-bold leading-tight tracking-[.06em] text-white">{ data.Display }</div>
					<button type="button" data-clipboard={ data.Clipboard }
						onclick="navigator.clipboard.writeText(this.dataset.clipboard).then(() => { this.textContent = 'Copié !'; })"
						class="flex w-[132px] shrink-0 items-center justify-center rounded-[10px] bg-brand text-[15px] font-semibold text-white hover:bg-brand-strong">Copier</button>
				</div>
			} else {
				<div class="rounded-[10px] border border-dashed border-ink-3 px-4.5 py-4 font-mono text-[15px] text-sidebar-muted">Le code n'est plus affichable — seulement régénérable.</div>
			}
			if data.Help != "" && data.Display != "" {
				<div class="mt-3.5 max-w-[640px] text-sm leading-normal text-sidebar-text">{ data.Help }</div>
			}
			if data.Display == "" {
				<div class="mt-3.5 max-w-[640px] text-sm leading-normal text-sidebar-text">Si la personne n'a pas reçu son code, régénérez-en un : le précédent cesse alors d'être valable.</div>
			}
		</div>
		<div class="w-px self-stretch bg-ink-3"></div>
		<div class="flex w-[250px] shrink-0 flex-col gap-3">
			@Eyebrow("Cycle de vie", "text-sidebar-muted")
			@tokenLifecycleStep("En attente", data.Status == "pending", data.Expires)
			@tokenLifecycleStep("Utilisé", data.Status == "used", "")
			@tokenLifecycleStep("Expiré", data.Status == "expired", "")
			@tokenLifecycleStep("Révoqué", data.Status == "revoked", "")
			if data.RegenerateAction != "" || data.RevokeAction != "" {
				<div class="mt-1.5 flex gap-2">
					if data.RegenerateAction != "" {
						<form method="post" action={ templ.SafeURL(data.RegenerateAction) } class="flex-1">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<button type="submit" class="h-[34px] w-full rounded-lg border border-ink-4 text-center text-[13px] font-medium text-white hover:bg-ink-3">Régénérer</button>
						</form>
					}
					if data.RevokeAction != "" && data.Status == "pending" {
						<form method="post" action={ templ.SafeURL(data.RevokeAction) } class="flex-1">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<button type="submit" class="h-[34px] w-full rounded-lg border border-ink-4 text-center text-[13px] font-medium text-crit-soft hover:bg-ink-3">Révoquer</button>
						</form>
					}
				</div>
			}
		</div>
	</div>
}
