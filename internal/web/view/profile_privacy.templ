package view

import "github.com/bornholm/automata/internal/i18n"

// PRO-04 — Confidentialité : ce qu'Automata conserve, dit simplement, et
// les deux droits qui comptent — emporter ses données, les faire effacer.
// Aucune culpabilisation, aucun obstacle : une personne qui veut partir
// doit pouvoir le faire en deux gestes.

type PrivacyItem struct {
	Title  string
	Detail string
	// Count décrit le volume détenu (« 128 messages »), vide si inconnu.
	Count string
}

type PrivacyPage struct {
	LinkID    string
	Header    ProfileHeader
	CSRFToken string
	PluginUIs []ProfilePluginUI

	Items []PrivacyItem
	// Deleted bascule la page en confirmation après une suppression.
	Deleted bool
	Report  string
	Error   string
}

// privacyNav : une fois le compte supprimé, il n'y a plus de profil où
// naviguer.
func privacyNav(page PrivacyPage) ProfileNav {
	if page.Deleted {
		return ProfileNav{}
	}
	return ProfileNav{LinkID: page.LinkID, Active: "privacy", Plugins: page.PluginUIs}
}

templ ProfilePrivacy(page PrivacyPage) {
	@ProfileLayout(i18n.TC(ctx, "privacy.title"), page.Header, privacyNav(page)) {
		if page.Deleted {
			<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">{ i18n.TC(ctx, "privacy.deleted.title") }</h1>
			<p class="mt-2 text-[15px] leading-normal text-text-3">{ page.Report }</p>
			<div class="mt-5 rounded-xl border border-line-2 bg-panel p-4.5 text-[15px] leading-relaxed text-text-2">
				{ i18n.TC(ctx, "privacy.deleted.body_long") }
			</div>
			<div class="mt-5 text-sm text-text-4">{ i18n.TC(ctx, "privacy.deleted.body") }</div>
		} else {
			<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">{ i18n.TC(ctx, "privacy.heading") }</h1>
			<p class="mt-2 text-[15px] leading-normal text-text-3">{ i18n.TC(ctx, "privacy.intro") }</p>
			if page.Error != "" {
				<div class="mt-4 rounded-lg bg-crit-wash px-3.5 py-2.5 text-sm text-crit-deep">{ page.Error }</div>
			}
			<div class="mt-5 flex flex-col gap-2.5">
				for _, item := range page.Items {
					<div class="rounded-xl border border-line-2 p-4">
						<div class="flex items-baseline gap-2">
							<div class="text-base font-semibold text-ink">{ item.Title }</div>
							if item.Count != "" {
								<div class="font-mono text-[13px] text-text-4">{ item.Count }</div>
							}
						</div>
						<div class="mt-1 text-sm leading-normal text-text-3">{ item.Detail }</div>
					</div>
				}
			</div>
			<div class="mt-5 rounded-xl border border-brand-line bg-brand-wash-2 p-4">
				<div class="text-base font-semibold leading-snug text-ink">{ i18n.TC(ctx, "privacy.correct.title") }</div>
				<div class="mt-1 text-sm leading-normal text-text-2">{ i18n.TC(ctx, "privacy.correct.body") }</div>
				<a href={ templ.SafeURL("/p/" + page.LinkID + "/memories") } class="mt-3 flex h-11 w-fit items-center rounded-[10px] bg-brand px-5 text-[15px] font-semibold text-white hover:bg-brand-strong hover:no-underline">{ i18n.TC(ctx, "privacy.correct.link") }</a>
			</div>
			<div class="mt-6">
				@Eyebrow(i18n.TC(ctx, "privacy.section.export"), "text-text-4")
			</div>
			<a
				href={ templ.SafeURL("/p/" + page.LinkID + "/privacy/export") }
				class="mt-3 flex h-12 w-full items-center justify-center rounded-[10px] border border-line text-base font-semibold text-text hover:bg-panel hover:no-underline"
			>
				{ i18n.TC(ctx, "privacy.export.link") }
			</a>
			<div class="mt-2 text-[13px] leading-normal text-text-4">{ i18n.TC(ctx, "privacy.export.body") }</div>
			<div class="mt-6">
				@Eyebrow(i18n.TC(ctx, "privacy.section.delete"), "text-text-4")
			</div>
			<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/privacy/delete") } class="mt-3 rounded-xl border border-crit-wash bg-crit-row p-4.5">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<div class="text-base font-semibold leading-snug text-crit-deep">{ i18n.TC(ctx, "privacy.delete.title") }</div>
				<div class="mt-1.5 text-sm leading-normal text-text-2">
					{ i18n.TC(ctx, "privacy.delete.body") }
				</div>
				<label class="mt-3.5 block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">{ i18n.TC(ctx, "privacy.delete.prompt") } <span class="font-mono font-semibold">{ i18n.TC(ctx, "privacy.delete_keyword") }</span></span>
					<input
						type="text"
						name="confirmation"
						required
						autocomplete="off"
						class="h-12 w-full rounded-[10px] border border-line bg-white px-3.5 font-mono text-base text-ink outline-none focus:border-crit"
					/>
				</label>
				<button type="submit" class="mt-3 h-12 w-full rounded-[10px] bg-crit text-base font-semibold text-white hover:opacity-90">{ i18n.TC(ctx, "privacy.delete.button") }</button>
			</form>
		}
	}
}
