package view

// PRO-04 — Confidentialité : ce qu'Automata conserve, dit simplement, et
// les deux droits qui comptent — emporter ses données, les faire effacer.
// Aucune culpabilisation, aucun obstacle : une personne qui veut partir
// doit pouvoir le faire en deux gestes.

type PrivacyItem struct {
	Title  string
	Detail string
	// Count décrit le volume détenu (« 128 messages »), vide si inconnu.
	Count string
}

type PrivacyPage struct {
	LinkID    string
	Header    ProfileHeader
	CSRFToken string
	PluginUIs []ProfilePluginUI

	Items []PrivacyItem
	// Deleted bascule la page en confirmation après une suppression.
	Deleted bool
	Report  string
	Error   string
}

// privacyNav : une fois le compte supprimé, il n'y a plus de profil où
// naviguer.
func privacyNav(page PrivacyPage) ProfileNav {
	if page.Deleted {
		return ProfileNav{}
	}
	return ProfileNav{LinkID: page.LinkID, Active: "privacy", Plugins: page.PluginUIs}
}

templ ProfilePrivacy(page PrivacyPage) {
	@ProfileLayout("Vos données — Automata", page.Header, privacyNav(page)) {
		if page.Deleted {
			<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">C'est fait</h1>
			<p class="mt-2 text-[15px] leading-normal text-text-3">{ page.Report }</p>
			<div class="mt-5 rounded-xl border border-line-2 bg-panel p-4.5 text-[15px] leading-relaxed text-text-2">
				Automata ne vous reconnaît plus dans votre messagerie. Si vous lui écrivez à nouveau, il vous répondra comme à une inconnue ou un inconnu — il faudra un nouveau code pour vous rattacher.
			</div>
			<div class="mt-5 text-sm text-text-4">Vous pouvez fermer cette page.</div>
		} else {
			<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Vos données</h1>
			<p class="mt-2 text-[15px] leading-normal text-text-3">Voici ce qu'Automata conserve à votre sujet, et ce que vous pouvez en faire.</p>
			if page.Error != "" {
				<div class="mt-4 rounded-lg bg-crit-wash px-3.5 py-2.5 text-sm text-crit-deep">{ page.Error }</div>
			}
			<div class="mt-5 flex flex-col gap-2.5">
				for _, item := range page.Items {
					<div class="rounded-xl border border-line-2 p-4">
						<div class="flex items-baseline gap-2">
							<div class="text-base font-semibold text-ink">{ item.Title }</div>
							if item.Count != "" {
								<div class="font-mono text-[13px] text-text-4">{ item.Count }</div>
							}
						</div>
						<div class="mt-1 text-sm leading-normal text-text-3">{ item.Detail }</div>
					</div>
				}
			</div>
			<div class="mt-5 rounded-xl border border-brand-line bg-brand-wash-2 p-4">
				<div class="text-base font-semibold leading-snug text-ink">Corriger ce que je retiens</div>
				<div class="mt-1 text-sm leading-normal text-text-2">Vos souvenirs se lisent et se modifient un par un — un souvenir faux vaut moins que pas de souvenir du tout.</div>
				<a href={ templ.SafeURL("/p/" + page.LinkID + "/memories") } class="mt-3 flex h-11 w-fit items-center rounded-[10px] bg-brand px-5 text-[15px] font-semibold text-white hover:bg-brand-strong hover:no-underline">Voir mes souvenirs</a>
			</div>
			<div class="mt-6">
				@Eyebrow("Emporter vos données", "text-text-4")
			</div>
			<a
				href={ templ.SafeURL("/p/" + page.LinkID + "/privacy/export") }
				class="mt-3 flex h-12 w-full items-center justify-center rounded-[10px] border border-line text-base font-semibold text-text hover:bg-panel hover:no-underline"
			>
				Télécharger mes données
			</a>
			<div class="mt-2 text-[13px] leading-normal text-text-4">Un fichier lisible, à conserver où vous voulez.</div>
			<div class="mt-6">
				@Eyebrow("Effacer vos données", "text-text-4")
			</div>
			<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/privacy/delete") } class="mt-3 rounded-xl border border-crit-wash bg-crit-row p-4.5">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<div class="text-base font-semibold leading-snug text-crit-deep">Supprimer définitivement</div>
				<div class="mt-1.5 text-sm leading-normal text-text-2">
					Vos messages privés, vos souvenirs et vos rappels seront effacés, et votre compte détaché de votre messagerie. Les échanges de groupe restent : ils appartiennent aussi aux autres participants. Vos relevés de consommation sont conservés sans vous être rattachés, parce qu'ils servent de pièces comptables.
				</div>
				<label class="mt-3.5 block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Pour confirmer, écrivez <span class="font-mono font-semibold">SUPPRIMER</span></span>
					<input
						type="text"
						name="confirmation"
						required
						autocomplete="off"
						class="h-12 w-full rounded-[10px] border border-line bg-white px-3.5 font-mono text-base text-ink outline-none focus:border-crit"
					/>
				</label>
				<button type="submit" class="mt-3 h-12 w-full rounded-[10px] bg-crit text-base font-semibold text-white hover:opacity-90">Supprimer mes données</button>
			</form>
		}
	}
}
