package view

// ADM-06 — Consommation et refacturation : explorer les coûts d'inférence
// mesurés, par organisation, membre, agent ou modèle. C'est l'écran des
// questions précises (« qui a coûté quoi le mois dernier ? »), là où la
// tarification répond à la question globale.

type UsageRow struct {
	// Keys porte les valeurs des dimensions demandées, dans l'ordre.
	Keys    []string
	Calls   int64
	Tokens  int64
	Credits int64
	CostUSD string
	// Unreported compte les appels sans coût rapporté par le fournisseur.
	Unreported int64
}

type UsageOption struct {
	Value    string
	Label    string
	Selected bool
}

type UsagePage struct {
	Platforms []SidebarPlatform
	CSRFToken string

	// From et To bornent la période, au format des champs date.
	From string
	To   string
	// Dimensions décrit les axes d'agrégation proposés et cochés.
	Dimensions []UsageOption
	// Headers nomme les colonnes de dimension du tableau.
	Headers []string

	Rows []UsageRow

	TotalCalls      int64
	TotalTokens     int64
	TotalCredits    int64
	TotalCostUSD    string
	TotalUnreported int64
	// ExportURL reprend les filtres courants.
	ExportURL string
}

templ AdminUsage(page UsagePage) {
	@AdminLayout("Consommation — Automata Admin", "usage", page.Platforms, page.CSRFToken) {
		<header class="border-b border-line-2 bg-white px-4 py-4 md:px-7 md:py-5.5">
			<h1 class="text-[21px] font-semibold leading-tight tracking-[-.01em] text-ink">Consommation et refacturation</h1>
			<div class="mt-0.5 text-sm text-text-3">Coûts d'inférence mesurés, tels que les fournisseurs les rapportent</div>
		</header>
		<div class="flex flex-col gap-5 p-4 md:p-7">
			<form method="get" action="/admin/usage" class="flex flex-wrap items-end gap-4 rounded-[11px] border border-line-2 bg-white p-5">
				<label class="block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Du</span>
					<input type="date" name="from" value={ page.From } class="h-[38px] rounded-lg border border-line px-3 font-mono text-sm outline-none focus:border-brand"/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Au <span class="font-normal text-text-4">— exclu</span></span>
					<input type="date" name="to" value={ page.To } class="h-[38px] rounded-lg border border-line px-3 font-mono text-sm outline-none focus:border-brand"/>
				</label>
				<div class="min-w-0 flex-1">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Regrouper par</span>
					<div class="flex flex-wrap gap-2">
						for _, dimension := range page.Dimensions {
							<label class={ "cursor-pointer rounded-lg border px-3 py-1.5 text-[13px]", templ.KV("border-brand bg-brand-wash font-semibold text-brand-deep", dimension.Selected), templ.KV("border-line font-medium text-text-2", !dimension.Selected) }>
								<input type="checkbox" name="by" value={ dimension.Value } checked?={ dimension.Selected } class="mr-1.5 align-middle"/>
								{ dimension.Label }
							</label>
						}
					</div>
				</div>
				<button type="submit" class="h-[38px] rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-strong">Actualiser</button>
				<a href={ templ.SafeURL(page.ExportURL) } class="flex h-[38px] items-center rounded-lg border border-line px-4 text-sm font-medium text-text hover:bg-panel hover:no-underline">Exporter en CSV</a>
			</form>
			<div class="overflow-hidden rounded-[11px] border border-line-2 bg-white">
				<div class="flex items-center gap-4 border-b border-line-2 px-5 py-3.5">
					<div class="text-[15px] font-semibold text-ink">Détail</div>
					<div class="text-[13px] text-text-4">{ FormatInt(page.TotalCalls) } appels · { FormatInt(page.TotalCredits) } crédits · { page.TotalCostUSD }</div>
					if page.TotalUnreported > 0 {
						<div class="ml-auto text-[13px] text-warn-deep">{ FormatInt(page.TotalUnreported) } appel(s) sans coût rapporté</div>
					}
				</div>
				if len(page.Rows) == 0 {
					<div class="px-5 py-10 text-center text-sm text-text-4">Aucune consommation mesurée sur cette période.</div>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full min-w-[720px] border-collapse">
							<thead>
								<tr class="border-b border-line-2 bg-panel">
									for _, header := range page.Headers {
										<th class="px-5 py-2.5 text-left font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">{ header }</th>
									}
									<th class="px-5 py-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">Appels</th>
									<th class="px-5 py-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">Tokens</th>
									<th class="px-5 py-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">Crédits</th>
									<th class="px-5 py-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">Coût</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range page.Rows {
									<tr class="border-b border-line-3 last:border-b-0">
										for _, key := range row.Keys {
											<td class="px-5 py-3 text-sm text-text">
												if key == "" {
													<span class="text-text-4">(non attribué)</span>
												} else {
													{ key }
												}
											</td>
										}
										<td class="px-5 py-3 text-right font-mono text-sm text-text tabular-nums">{ FormatInt(row.Calls) }</td>
										<td class="px-5 py-3 text-right font-mono text-sm text-text-3 tabular-nums">{ FormatInt(row.Tokens) }</td>
										<td class="px-5 py-3 text-right font-mono text-sm text-text tabular-nums">{ FormatInt(row.Credits) }</td>
										<td class="px-5 py-3 text-right font-mono text-sm text-text tabular-nums">
											{ row.CostUSD }
											if row.Unreported > 0 {
												<span class="ml-1.5 text-[11px] text-warn-deep" title="Appels sans coût rapporté par le fournisseur">◦{ FormatInt(row.Unreported) }</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
			<div class="text-[13px] leading-normal text-text-4">Les coûts proviennent des fournisseurs qui les rapportent (OpenRouter). Les autres n'apportent que des tokens : leurs appels sont comptés, leur coût vaut zéro — d'où le repère sur les lignes concernées.</div>
		</div>
	}
}
