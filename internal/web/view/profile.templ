package view

// Profil utilisateur (PRO-01, PRO-02, PRO-90) — mobile d'abord, ouvert par
// lien temporaire. Chaque page s'ouvre sur l'en-tête d'identification
// (ProfileLayout) puis une tâche unique. Le solde est toujours énoncé en
// durée avant d'être chiffré ; le chiffre reste présent, en mono et en
// second plan (annotation des maquettes).

// ProfileTab est une entrée de la navigation du profil.
type ProfileTab struct {
	Label  string
	Href   string
	Active bool
}

// ProfileTabs assemble les pages fixes du profil, puis un onglet par
// plugin doté d'une interface. La liste n'a pas de longueur connue à
// l'avance : une organisation active autant de plugins qu'elle veut, et
// quatre libellés côte à côte débordaient déjà d'un écran de téléphone.
func ProfileTabs(linkID string, active string, plugins []ProfilePluginUI) []ProfileTab {
	base := "/p/" + linkID
	tabs := []ProfileTab{
		{Label: "Profil", Href: base, Active: active == "profile"},
		{Label: "Découvrir", Href: base + "/discover", Active: active == "discover"},
		{Label: "Ce que je retiens", Href: base + "/memories", Active: active == "memories"},
		{Label: "Suggestions", Href: base + "/suggestions", Active: active == "suggestions"},
		{Label: "Crédits", Href: base + "/credits", Active: active == "credits"},
		{Label: "Ma consommation", Href: base + "/usage", Active: active == "usage"},
		{Label: "Confidentialité", Href: base + "/privacy", Active: active == "privacy"},
	}
	for _, plugin := range plugins {
		tabs = append(tabs, ProfileTab{
			Label:  plugin.Title,
			Href:   base + "/plugins/" + plugin.Name,
			Active: active == "plugin:"+plugin.Name,
		})
	}
	return tabs
}

// --- PRO-01 — Mon profil ---

type ProfileChannel struct {
	PlatformType string
	Name         string
	Detail       string
}

type ProfilePage struct {
	LinkID    string
	Header    ProfileHeader
	CSRFToken string

	// EmailState : absent | pending | verified.
	EmailState string
	Email      string
	// MailConfigured : sans provider mail configuré, l'envoi de code est
	// proposé mais désactivé.
	MailConfigured bool
	Error          string

	Channels []ProfileChannel

	// PluginUIs : plugins actifs pour l'organisation du membre et dotés
	// d'une interface. Chacun a son onglet et sa page (ProfilePlugin) ;
	// ici, ils ne servent qu'à peupler la navigation.
	PluginUIs []ProfilePluginUI
}

type ProfilePluginUI struct {
	Name string
	// Title : nom lisible du plugin (description courte).
	Title string
	// Src : URL du proxy vers l'interface du plugin.
	Src string
}

// profileHomeNav : pas de navigation pendant la saisie d'un code, la page
// est un guichet, on ne doit rien pouvoir faire d'autre.
func profileHomeNav(page ProfilePage) ProfileNav {
	if page.EmailState == "pending" {
		return ProfileNav{}
	}
	return ProfileNav{LinkID: page.LinkID, Active: "profile", Plugins: page.PluginUIs}
}

templ ProfileHome(page ProfilePage) {
	@ProfileLayout("Votre profil — Automata", page.Header, profileHomeNav(page)) {
		if page.EmailState == "pending" {
			<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Vérifions cette adresse</h1>
			<p class="mt-2 text-[15px] leading-normal text-text-3">Nous avons envoyé six chiffres à <span class="font-medium text-text">{ page.Email }</span>.</p>
			<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/email/verify") }>
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				if page.Error != "" {
					<div class="mt-4 rounded-lg bg-crit-wash px-3.5 py-2.5 text-sm text-crit-deep">{ page.Error }</div>
				}
				<input
					type="text"
					name="code"
					inputmode="numeric"
					pattern="[0-9]{6}"
					maxlength="6"
					required
					autofocus
					placeholder="······"
					class="mt-5 h-14 w-full rounded-[10px] border border-brand-line-2 bg-brand-wash-2 text-center font-mono text-[22px] font-bold tracking-[.5em] text-ink outline-none placeholder:text-text-5 focus:border-brand"
				/>
				<button type="submit" class="mt-4 h-12 w-full rounded-[10px] bg-brand text-base font-semibold text-white hover:bg-brand-strong">Valider</button>
			</form>
			<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/email") } class="mt-3.5 text-center">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<input type="hidden" name="email" value={ page.Email }/>
				<span class="text-sm text-text-4">Rien reçu ? </span>
				<button type="submit" class="text-sm font-medium text-brand">Renvoyer le code</button>
			</form>
			<div class="mt-6 rounded-[11px] bg-panel p-3.5 text-sm leading-normal text-text-3">Vous pouvez fermer cette page : Automata vous renverra un lien si besoin, il suffit de le lui demander dans votre conversation.</div>
		} else {
			<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Votre profil</h1>
			if page.EmailState == "verified" {
				<p class="mt-2 text-[15px] leading-normal text-text-3">Votre adresse de secours est en place.</p>
				<div class="mt-5 flex items-center gap-3 rounded-xl border border-ok-line bg-ok-wash-2 p-4">
					<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-ok text-sm font-bold text-white">✓</span>
					<div class="min-w-0">
						<div class="truncate text-[15px] font-semibold text-ok-deeper">{ page.Email }</div>
						<div class="text-[13px] text-ok-deep">Adresse vérifiée. Nous ne l'utiliserons que pour vous retrouver.</div>
					</div>
				</div>
			} else {
				<p class="mt-2 text-[15px] leading-normal text-text-3">Une adresse électronique nous permet de vous retrouver si vous changez de téléphone ou de numéro.</p>
				<div class="mt-5 rounded-xl border border-brand-line bg-brand-wash-2 p-4.5">
					<div class="text-base font-semibold leading-snug text-ink">Votre adresse de secours</div>
					<div class="mt-1 text-sm leading-normal text-text-2">Nous ne l'utiliserons que pour cela. Aucun courriel d'information.</div>
					<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/email") }>
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						if page.Error != "" {
							<div class="mt-3 rounded-lg bg-crit-wash px-3 py-2 text-[13px] text-crit-deep">{ page.Error }</div>
						}
						<input
							type="email"
							name="email"
							value={ page.Email }
							required
							placeholder="vous@exemple.fr"
							class="mt-3.5 h-12 w-full rounded-[10px] border border-brand-line-2 bg-white px-3.5 text-base text-ink outline-none placeholder:text-text-5 focus:border-brand"
						/>
						if page.MailConfigured {
							<button type="submit" class="mt-2.5 h-12 w-full rounded-[10px] bg-brand text-base font-semibold text-white hover:bg-brand-strong">Recevoir un code</button>
						} else {
							<span class="mt-2.5 flex h-12 w-full cursor-not-allowed items-center justify-center rounded-[10px] bg-brand/40 text-base font-semibold text-white" title="L'envoi de courriels n'est pas encore configuré sur cette instance">Recevoir un code</span>
						}
					</form>
				</div>
			}
			<div class="mt-6">
				@Eyebrow("Vos conversations avec Automata", "text-text-4")
			</div>
			<div class="mt-3 flex flex-col gap-2">
				if len(page.Channels) == 0 {
					<div class="rounded-[11px] border border-dashed border-line px-3.5 py-3 text-sm text-text-4">Aucune conversation rattachée pour l'instant.</div>
				}
				for _, ch := range page.Channels {
					<div class="flex items-center gap-2.5 rounded-[11px] border border-line-2 px-3.5 py-3">
						@PlatformBadge(ch.PlatformType, "size-[26px] rounded-lg", "text-[11px]")
						<div class="min-w-0">
							<div class="truncate text-[15px] font-medium text-text">{ ch.Name }</div>
							<div class="text-xs text-text-4">{ ch.Detail }</div>
						</div>
					</div>
				}
			</div>
		}
	}
}

// --- PRO-02 — Crédits et recharge ---

type CreditPack struct {
	// Index est le rang du pack dans la configuration : c'est lui qui est
	// soumis au paiement, jamais un montant ni un prix venus du navigateur.
	Index    int
	Credits  int64
	Duration string // « Environ un mois »
	PriceEUR string // « 35 € HT »
	Featured bool
	// FeaturedLabel : « Le plus choisi » / « Votre habitude ».
	FeaturedLabel string
}

type MonthUsage struct {
	Label   string
	Credits int64
}

type UsageSplit struct {
	Label   string
	Credits int64
	Pct     int
	// Shade : "" (accent), "soft", "faint" — dégradé des barres.
	Shade string
}

type CreditsPage struct {
	LinkID    string
	Header    ProfileHeader
	CSRFToken string
	PluginUIs []ProfilePluginUI

	// State : ok | low | empty | offered | unlimited.
	State       string
	Balance     int64
	GaugeRef    int64
	GaugePct    int
	BalanceHint string // durée parlée, toujours avant le chiffre

	// Offerte.
	Allowance   int64
	UsedCredits int64
	NextReset   string // « le 1ᵉʳ septembre »
	Split       []UsageSplit

	// Payante.
	AutoTopUp       bool
	AutoTopUpAmount int64
	AutoTopUpBelow  int64
	Packs           []CreditPack
	FeaturedPrice   string
	FeaturedIndex   int
	Months          []MonthUsage
	// StripeEnabled active les boutons de paiement ; Notice porte le
	// message de retour (paiement confirmé, annulé, en erreur).
	StripeEnabled bool
	Notice        string
	NoticeTone    string
}

func usageSplitClass(shade string) string {
	switch shade {
	case "soft":
		return "bg-brand-soft"
	case "faint":
		return "bg-brand-line-2"
	default:
		return "bg-brand"
	}
}

templ creditPackRow(pack CreditPack) {
	<div class={ "flex items-center gap-3 rounded-[11px] border px-4 py-3.5", templ.KV("border-brand bg-brand-wash-2", pack.Featured), templ.KV("border-line-2", !pack.Featured) }>
		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<div class="text-base font-semibold leading-tight text-text">{ FormatInt(pack.Credits) } crédits</div>
				if pack.Featured && pack.FeaturedLabel != "" {
					<span class="rounded-full bg-brand px-1.5 py-0.5 text-[11px] font-semibold text-white">{ pack.FeaturedLabel }</span>
				}
			</div>
			if pack.Duration != "" {
				<div class={ "mt-0.5 text-[13px] leading-tight", templ.KV("text-text-2", pack.Featured), templ.KV("text-text-4", !pack.Featured) }>{ pack.Duration }</div>
			}
		</div>
		<div class="font-mono text-base text-text">{ pack.PriceEUR }</div>
	</div>
}

templ payButton(page CreditsPage, label string) {
	if page.StripeEnabled {
		<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/checkout") }>
			<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
			<input type="hidden" name="pack" value={ itoa(page.FeaturedIndex) }/>
			<button type="submit" class="mt-3.5 h-12 w-full rounded-[10px] bg-brand text-base font-semibold text-white hover:bg-brand-strong">{ label }</button>
		</form>
		<div class="mt-2 text-center text-[13px] leading-normal text-text-4">Prix hors taxes : la TVA applicable s'ajoute au moment du paiement. Paiement traité par Stripe, vos crédits sont ajoutés dès la confirmation.</div>
	} else {
		<span class="mt-3.5 flex h-12 w-full cursor-not-allowed items-center justify-center rounded-[10px] bg-brand/40 text-base font-semibold text-white" title="Paiement en ligne non configuré">{ label }</span>
		<div class="mt-2 text-center text-[13px] leading-normal text-text-4">Le paiement en ligne n'est pas encore ouvert. Vos crédits peuvent être ajoutés par l'exploitant du service.</div>
	}
}

templ ProfileCredits(page CreditsPage) {
	@ProfileLayout("Vos crédits — Automata", page.Header, ProfileNav{LinkID: page.LinkID, Active: "credits", Plugins: page.PluginUIs}) {
		if page.Notice != "" {
			if page.NoticeTone == "ok" {
				<div class="mb-4 rounded-xl border border-ok-line bg-ok-wash-2 px-4 py-3 text-[15px] leading-snug text-ok-deeper">{ page.Notice }</div>
			} else {
				<div class="mb-4 rounded-xl border border-line-2 bg-panel px-4 py-3 text-[15px] leading-snug text-text-2">{ page.Notice }</div>
			}
		}
		switch page.State {
			case "unlimited":
				<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Votre usage du mois</h1>
				<div class="mt-5 rounded-[14px] border border-line-2 p-4.5">
					<div class="text-[21px] font-semibold leading-snug text-ink">{ page.BalanceHint }</div>
					<div class="mt-3.5 text-sm leading-normal text-text-3">
						Aucun plafond, aucune recharge à prévoir. Vous avez utilisé { FormatInt(page.UsedCredits) } crédits ce mois-ci — c'est indicatif, rien ne vous est décompté.
					</div>
				</div>
				<div class="mt-4 flex items-center gap-2.5 rounded-[11px] bg-brand-wash-2 px-4 py-3">
					@Logo("size-[22px] rounded-[7px]", "text-[11px]")
					<div class="text-sm leading-snug text-brand-deep">Cet accès vous est offert par Automata, sans limite. Rien à payer, rien à renouveler.</div>
				</div>
				if len(page.Split) > 0 {
					<div class="mt-6">
						@Eyebrow("Ce mois-ci, en gros", "text-text-4")
					</div>
					<div class="mt-3.5 flex flex-col gap-3">
						for _, split := range page.Split {
							<div>
								<div class="mb-1.5 flex justify-between">
									<span class="text-[15px] leading-tight text-text">{ split.Label }</span>
									<span class="font-mono text-sm leading-tight text-text-3">{ FormatCredits(split.Credits) }</span>
								</div>
								<div class="h-[7px] w-full overflow-hidden rounded-full bg-track">
									<div class={ "h-full rounded-full", usageSplitClass(split.Shade) } style={ templ.SafeCSS("width:" + itoa(split.Pct) + "%") }></div>
								</div>
							</div>
						}
					</div>
				}
			case "offered":
				<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Votre usage du mois</h1>
				<div class="mt-5 rounded-[14px] border border-line-2 p-4.5">
					<div class="text-[21px] font-semibold leading-snug text-ink">{ page.BalanceHint }</div>
					<div class="mt-4">
						@Gauge(page.GaugePct, "brand", "h-2.5")
					</div>
					<div class="mt-2 flex justify-between font-mono text-[13px]">
						<span class="text-text-3">{ FormatInt(page.UsedCredits) } crédits utilisés</span>
						<span class="text-text-4">sur { FormatInt(page.Allowance) }</span>
					</div>
					<div class="mt-3.5 text-sm leading-normal text-text-3">Votre allocation revient à { FormatInt(page.Allowance) } crédits { page.NextReset }. Elle ne se cumule pas d'un mois sur l'autre — inutile d'économiser.</div>
				</div>
				<div class="mt-4 flex items-center gap-2.5 rounded-[11px] bg-brand-wash-2 px-4 py-3">
					@Logo("size-[22px] rounded-[7px]", "text-[11px]")
					<div class="text-sm leading-snug text-brand-deep">Cet accès vous est offert par Automata. Rien à payer, rien à renouveler.</div>
				</div>
				if len(page.Split) > 0 {
					<div class="mt-6">
						@Eyebrow("Ce mois-ci, en gros", "text-text-4")
					</div>
					<div class="mt-3.5 flex flex-col gap-3">
						for _, split := range page.Split {
							<div>
								<div class="mb-1.5 flex justify-between">
									<span class="text-[15px] leading-tight text-text">{ split.Label }</span>
									<span class="font-mono text-sm leading-tight text-text-3">{ FormatCredits(split.Credits) }</span>
								</div>
								<div class="h-[7px] w-full overflow-hidden rounded-full bg-track">
									<div class={ "h-full rounded-full", usageSplitClass(split.Shade) } style={ templ.SafeCSS("width:" + itoa(split.Pct) + "%") }></div>
								</div>
							</div>
						}
					</div>
				}
			case "empty":
				<div class="rounded-[14px] bg-ink p-5">
					@Eyebrow("Service en pause", "text-brand-soft")
					<div class="mt-3.5 text-2xl font-semibold leading-tight tracking-[-.01em] text-white">Automata vous attend, ses crédits sont épuisés</div>
					<div class="mt-2.5 text-[15px] leading-relaxed text-sidebar-text">Vos souvenirs, vos rappels et vos conversations sont intacts. Une recharge et tout reprend là où vous l'avez laissé.</div>
					<div class="mt-4.5 h-2.5 rounded-full bg-ink-3"></div>
					<div class="mt-2 font-mono text-[13px] text-sidebar-muted">0 crédit</div>
				</div>
				<div class="mt-5 flex flex-col gap-2">
					for _, pack := range page.Packs {
						@creditPackRow(pack)
					}
				</div>
				@payButton(page, "Réactiver Automata — "+page.FeaturedPrice)
			default:
				<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Vos crédits</h1>
				if page.State == "low" {
					<div class="mt-5 rounded-[14px] border border-warn-line bg-warn-row p-4.5">
						<div class="text-[21px] font-semibold leading-snug text-ink">{ page.BalanceHint }</div>
						<div class="mt-4 h-2.5 w-full overflow-hidden rounded-full bg-warn-track">
							<div class="h-full rounded-full bg-warn" style={ templ.SafeCSS("width:" + itoa(page.GaugePct) + "%") }></div>
						</div>
						<div class="mt-2 flex justify-between font-mono text-[13px]">
							<span class="text-warn-deep">{ FormatInt(page.Balance) } crédits</span>
							if page.GaugeRef > 0 {
								<span class="text-warn-soft">sur { FormatInt(page.GaugeRef) }</span>
							}
						</div>
						<div class="mt-3.5 text-sm leading-normal text-warn-deep">Rien n'est interrompu pour l'instant. Une recharge maintenant vous évite une coupure.</div>
					</div>
				} else {
					<div class="mt-5 rounded-[14px] border border-line-2 p-4.5">
						<div class="text-[21px] font-semibold leading-snug text-ink">{ page.BalanceHint }</div>
						<div class="mt-4">
							@Gauge(page.GaugePct, "brand", "h-2.5")
						</div>
						<div class="mt-2 flex justify-between font-mono text-[13px]">
							<span class="text-text-3">{ FormatInt(page.Balance) } crédits</span>
							if page.GaugeRef > 0 {
								<span class="text-text-4">sur { FormatInt(page.GaugeRef) }</span>
							}
						</div>
					</div>
				}
				if page.AutoTopUp {
					<div class="mt-4 flex gap-2.5 rounded-xl border border-ok-line bg-ok-wash-2 px-4 py-3.5">
						<div class="flex h-[22px] w-[38px] shrink-0 justify-end rounded-full bg-ok p-0.5"><span class="size-[18px] rounded-full bg-white"></span></div>
						<div>
							<div class="text-[15px] font-semibold leading-snug text-ok-deeper">Recharge automatique active</div>
							<div class="mt-0.5 text-sm leading-normal text-ok-deep">Nous rechargeons { FormatInt(page.AutoTopUpAmount) } crédits dès que vous descendez sous { FormatInt(page.AutoTopUpBelow) }. Vous n'avez rien à surveiller.</div>
						</div>
					</div>
				} else {
					<div class="mt-4 flex gap-2.5 rounded-xl border border-line-2 px-4 py-4" title="Activation à venir avec le paiement Stripe">
						<div class="flex h-[22px] w-[38px] shrink-0 rounded-full bg-track p-0.5"><span class="size-[18px] rounded-full bg-white"></span></div>
						<div>
							<div class="text-[15px] font-semibold leading-snug text-ink">Ne plus y penser</div>
							<div class="mt-0.5 text-sm leading-normal text-text-3">Rechargez automatiquement dès que le solde passe sous un seuil. Arrive avec le paiement en ligne.</div>
						</div>
					</div>
				}
				<div class="mt-6">
					@Eyebrow("Ajouter des crédits", "text-text-4")
				</div>
				<div class="mt-3 flex flex-col gap-2">
					for _, pack := range page.Packs {
						@creditPackRow(pack)
					}
				</div>
				if page.FeaturedPrice != "" {
					@payButton(page, "Payer "+page.FeaturedPrice+" en sécurité")
				}
				if len(page.Months) > 0 {
					<div class="mt-6 border-t border-line-3 pt-4">
						@Eyebrow("Ces derniers mois", "text-text-4")
						<div class="mt-2 flex flex-col">
							for i, month := range page.Months {
								if i > 0 {
									<div class="h-px bg-line-3"></div>
								}
								<div class="flex justify-between py-2">
									<span class="text-[15px] text-text">{ month.Label }</span>
									<span class="font-mono text-sm text-text-3">{ FormatCredits(month.Credits) }</span>
								</div>
							}
						</div>
					</div>
				}
		}
	}
}

// --- Interface d'un plugin ---

// ProfilePluginPage rend l'interface d'un plugin dans son propre onglet.
// L'iframe est SANDBOXÉE sans allow-same-origin (origine opaque : le
// document du plugin n'accède ni aux cookies ni au DOM de la page). Elle
// occupe la hauteur disponible parce qu'elle est désormais seule sur la
// page — cousue sous le profil, elle était réduite à une lucarne.
// allow-downloads : un téléchargement exige un geste de l'utilisateur et
// le contenu vient d'UI de plugins déjà proxifiées et authentifiées —
// c'est ce qui permet au plugin pages de servir l'archive d'un espace.
// allow-popups reste refusé : pas de target="_blank" dans une UI de
// plugin.
type ProfilePluginPage struct {
	LinkID  string
	Header  ProfileHeader
	Current ProfilePluginUI
	// PluginUIs : tous les plugins, pour la navigation.
	PluginUIs []ProfilePluginUI
}

templ ProfilePlugin(page ProfilePluginPage) {
	@ProfileLayout(page.Current.Title+" — Automata", page.Header, ProfileNav{LinkID: page.LinkID, Active: "plugin:"+page.Current.Name, Plugins: page.PluginUIs}) {
		<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">{ page.Current.Title }</h1>
		<div class="mt-5 overflow-hidden rounded-[11px] border border-line-2 bg-white">
			<iframe src={ page.Current.Src } title={ page.Current.Title } sandbox="allow-forms allow-scripts allow-downloads" class="block h-[560px] w-full border-0 md:h-[720px]"></iframe>
		</div>
	}
}

// --- PRO-90 — États de lien ---

// LinkOpenPage est le seuil d'un lien encore intact : le visiteur
// l'ouvre lui-même, d'un clic.
type LinkOpenPage struct {
	LinkID    string
	CSRFToken string
	// Name : prénom de la personne, pour qu'elle reconnaisse son lien.
	Name string
}

// ProfileLinkOpen demande une action avant de consommer le lien.
//
// Les messageries préchargent les liens qu'on y colle pour en afficher un
// aperçu : Rocket.Chat, Slack ou WhatsApp ouvrent l'adresse avant tout
// humain. Un lien à usage unique consommé par un GET serait donc grillé
// avant d'avoir servi. Le clic sur ce bouton — un POST, que nul robot
// d'aperçu n'émet — est ce qui l'ouvre vraiment.
templ ProfileLinkOpen(page LinkOpenPage) {
	@ProfileStateLayout("Votre profil — Automata") {
		@Logo("size-11 rounded-xl", "text-[21px]")
		<div>
			if page.Name != "" {
				<h1 class="text-[27px] font-semibold leading-tight tracking-[-.015em] text-ink">Bonjour { page.Name }</h1>
			} else {
				<h1 class="text-[27px] font-semibold leading-tight tracking-[-.015em] text-ink">Votre profil</h1>
			}
			<p class="mt-2.5 text-base leading-relaxed text-text-3">Vos crédits, votre adresse de récupération et vos données personnelles. La page reste ouverte une quinzaine de minutes.</p>
		</div>
		<form method="post" action={ templ.SafeURL("/p/" + page.LinkID + "/open") }>
			<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
			<button type="submit" class="h-12 w-full rounded-[10px] bg-brand text-base font-semibold text-white hover:bg-brand-strong">Ouvrir mon profil</button>
		</form>
		<div class="text-sm text-text-4">Ce lien ne s'ouvre qu'une fois, et n'appartient qu'à vous : ne le transmettez à personne.</div>
	}
}

// LinkStatePage : expired | used | error.
type LinkStatePage struct {
	State string
	// Ref est la référence courte d'incident (état erreur).
	Ref string
}

templ ProfileLinkState(page LinkStatePage) {
	@ProfileStateLayout("Automata") {
		if page.State == "error" {
			<div class="flex size-11 items-center justify-center rounded-xl bg-panel-2 font-mono text-[21px] font-bold text-text-4">a</div>
		} else {
			@Logo("size-11 rounded-xl", "text-[21px]")
		}
		<div>
			switch page.State {
				case "used":
					<h1 class="text-[27px] font-semibold leading-tight tracking-[-.015em] text-ink">Ce lien a déjà servi</h1>
					<p class="mt-2.5 text-base leading-relaxed text-text-3">Chaque lien ne s'ouvre qu'une fois. Si vous avez fermé la page trop tôt, il suffit d'en redemander un.</p>
				case "error":
					<h1 class="text-[27px] font-semibold leading-tight tracking-[-.015em] text-ink">Quelque chose n'a pas fonctionné</h1>
					<p class="mt-2.5 text-base leading-relaxed text-text-3">Nous n'avons pas pu ouvrir cette page. Réessayez dans un instant, ou dites-le à Automata dans votre conversation.</p>
				default:
					<h1 class="text-[27px] font-semibold leading-tight tracking-[-.015em] text-ink">Ce lien a expiré</h1>
					<p class="mt-2.5 text-base leading-relaxed text-text-3">C'est normal : les liens ne vivent qu'un quart d'heure, pour que personne d'autre ne puisse ouvrir votre profil.</p>
			}
		</div>
		switch page.State {
			case "used":
				<div class="rounded-xl border border-brand-line bg-brand-wash-2 p-4.5">
					<div class="text-base font-semibold leading-snug text-ink">Redemandez-en un à Automata</div>
					<div class="mt-1.5 text-[15px] leading-relaxed text-text-2">Dans votre conversation, écrivez simplement « mon profil ». Il vous répond avec un nouveau lien.</div>
				</div>
			case "error":
				<button onclick="location.reload()" class="h-12 rounded-[10px] border border-line text-base font-semibold text-text hover:bg-panel">Réessayer</button>
				if page.Ref != "" {
					<div class="font-mono text-xs text-text-5">réf. { page.Ref }</div>
				}
			default:
				<div class="rounded-xl border border-brand-line bg-brand-wash-2 p-4.5">
					<div class="text-base font-semibold leading-snug text-ink">Pour en recevoir un nouveau</div>
					<div class="mt-1.5 text-[15px] leading-relaxed text-text-2">Retournez dans votre conversation et écrivez à Automata : « envoie-moi le lien de mon profil ».</div>
				</div>
				<div class="text-sm text-text-4">Vous pouvez fermer cette page.</div>
		}
	}
}

// --- PRO-03 — Ma consommation ---

type UsageMonth struct {
	Label   string
	Credits int64
	Pct     int
	Current bool
}

type ProfileUsagePage struct {
	LinkID    string
	Header    ProfileHeader
	PluginUIs []ProfilePluginUI

	// Summary énonce l'usage du mois en langage humain, avant tout chiffre.
	Summary string
	Split   []UsageSplit
	Months  []UsageMonth
	// Shared prévient quand les chiffres couvrent toute l'organisation.
	Shared bool
}

templ ProfileUsage(page ProfileUsagePage) {
	@ProfileLayout("Ma consommation — Automata", page.Header, ProfileNav{LinkID: page.LinkID, Active: "usage", Plugins: page.PluginUIs}) {
		<h1 class="text-[26px] font-semibold leading-tight tracking-[-.015em] text-ink">Ma consommation</h1>
		<p class="mt-2 text-[15px] leading-normal text-text-3">{ page.Summary }</p>
		if len(page.Split) > 0 {
			<div class="mt-6">
				@Eyebrow("Ce mois-ci, en gros", "text-text-4")
			</div>
			<div class="mt-3.5 flex flex-col gap-3">
				for _, split := range page.Split {
					<div>
						<div class="mb-1.5 flex justify-between">
							<span class="text-[15px] leading-tight text-text">{ split.Label }</span>
							<span class="font-mono text-sm leading-tight text-text-3">{ FormatCredits(split.Credits) }</span>
						</div>
						<div class="h-[7px] w-full overflow-hidden rounded-full bg-track">
							<div class={ "h-full rounded-full", usageSplitClass(split.Shade) } style={ templ.SafeCSS("width:" + itoa(split.Pct) + "%") }></div>
						</div>
					</div>
				}
			</div>
		}
		if len(page.Months) > 0 {
			<div class="mt-6">
				@Eyebrow("Mois par mois", "text-text-4")
			</div>
			<div class="mt-3.5 flex flex-col gap-2.5">
				for _, month := range page.Months {
					<div>
						<div class="mb-1 flex justify-between">
							if month.Current {
								<span class="text-[15px] font-medium text-ink">{ month.Label }</span>
							} else {
								<span class="text-[15px] text-text-2">{ month.Label }</span>
							}
							<span class="font-mono text-sm text-text-3">{ FormatCredits(month.Credits) }</span>
						</div>
						<div class="h-1.5 w-full overflow-hidden rounded-full bg-track">
							if month.Current {
								<div class="h-full rounded-full bg-brand" style={ templ.SafeCSS("width:" + itoa(month.Pct) + "%") }></div>
							} else {
								<div class="h-full rounded-full bg-brand-line" style={ templ.SafeCSS("width:" + itoa(month.Pct) + "%") }></div>
							}
						</div>
					</div>
				}
			</div>
		}
		if page.Shared {
			<div class="mt-6 rounded-[11px] bg-panel p-3.5 text-sm leading-normal text-text-3">
				Ces chiffres couvrent toute votre organisation, pas seulement vous : les crédits sont partagés.
			</div>
		}
	}
}
