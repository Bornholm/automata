package view

// ADM-01 — Tableau de bord : l'écran qu'on regarde chaque matin. Il doit
// répondre en deux secondes à « est-ce que tout va bien ? », et ne montrer
// le détail que lorsque la réponse est non. D'où le parti pris : une ligne
// de repères, puis uniquement ce qui demande une attention — un écran
// vide, ici, est une bonne nouvelle.

type DashboardFigure struct {
	Label string
	Value string
	Hint  string
	// Tone : "" | ok | warn | crit.
	Tone string
}

type DashboardAlert struct {
	// Kind : platform | wallet | delivery | usage.
	Kind   string
	Title  string
	Detail string
	Tone   string
	Href   string
}

type DashboardPage struct {
	Platforms []SidebarPlatform
	CSRFToken string

	Figures []DashboardFigure
	Alerts  []DashboardAlert
	// Period nomme la période des chiffres (« août 2026 »).
	Period string
	// TopOrgs classe les organisations par consommation du mois.
	TopOrgs []DashboardOrgUsage
}

type DashboardOrgUsage struct {
	ID      string
	Name    string
	Credits int64
	// Pct est la part de la plus grosse consommation, pour la barre.
	Pct int
}

func figureValueClass(tone string) string {
	switch tone {
	case "ok":
		return "text-ok"
	case "warn":
		return "text-warn-deep"
	case "crit":
		return "text-crit"
	default:
		return "text-ink"
	}
}

func alertClasses(tone string) string {
	switch tone {
	case "crit":
		return "border-crit-wash bg-crit-row"
	case "warn":
		return "border-warn-line bg-warn-row"
	default:
		return "border-line-2 bg-white"
	}
}

templ AdminDashboard(page DashboardPage) {
	@AdminLayout("Tableau de bord — Automata Admin", "dashboard", page.Platforms, page.CSRFToken) {
		<header class="border-b border-line-2 bg-white px-4 py-4 md:px-7 md:py-5.5">
			<h1 class="text-[21px] font-semibold leading-tight tracking-[-.01em] text-ink">Tableau de bord</h1>
			<div class="mt-0.5 text-sm text-text-3">État du service et consommation de { page.Period }</div>
		</header>
		<div class="flex flex-col gap-5.5 p-4 md:p-7">
			<div class="flex flex-wrap gap-4 rounded-[11px] border border-line-2 bg-white p-5.5">
				for i, figure := range page.Figures {
					if i > 0 {
						<div class="w-px bg-line-2"></div>
					}
					<div class="min-w-[150px] flex-1">
						@Eyebrow(figure.Label, "text-text-4")
						<div class={ "mt-2 font-mono text-2xl", figureValueClass(figure.Tone) }>{ figure.Value }</div>
						if figure.Hint != "" {
							<div class="mt-1 text-[13px] leading-snug text-text-4">{ figure.Hint }</div>
						}
					</div>
				}
			</div>
			<div class="flex flex-col items-stretch gap-5 lg:flex-row lg:items-start">
				<div class="min-w-0 flex-1 overflow-hidden rounded-[11px] border border-line-2 bg-white">
					<div class="border-b border-line-2 px-5 py-3.5 text-[15px] font-semibold text-ink">À surveiller</div>
					if len(page.Alerts) == 0 {
						<div class="flex flex-col items-center gap-2 px-5 py-12 text-center">
							<div class="flex size-10 items-center justify-center rounded-full bg-ok-wash text-lg text-ok">✓</div>
							<div class="text-[15px] font-semibold text-ink">Rien à signaler</div>
							<div class="max-w-sm text-sm leading-normal text-text-3">Les comptes de messagerie répondent, aucune organisation n'est à court de crédits, et aucune livraison n'a échoué récemment.</div>
						</div>
					} else {
						for _, alert := range page.Alerts {
							<div class={ "flex items-start gap-3.5 border-b border-line-3 px-5 py-4 last:border-b-0", alertClasses(alert.Tone) }>
								<div class="min-w-0 flex-1">
									<div class="text-[15px] font-semibold text-ink">{ alert.Title }</div>
									<div class="mt-1 text-sm leading-normal text-text-3">{ alert.Detail }</div>
								</div>
								if alert.Href != "" {
									<a href={ templ.SafeURL(alert.Href) } class="shrink-0 text-[13px] font-medium text-brand">Voir</a>
								}
							</div>
						}
					}
				</div>
				<div class="w-full shrink-0 lg:w-[340px] rounded-[11px] border border-line-2 bg-white p-5.5">
					@Eyebrow("Consommation du mois", "text-text-4")
					if len(page.TopOrgs) == 0 {
						<div class="mt-3 text-sm text-text-4">Aucune consommation mesurée ce mois-ci.</div>
					} else {
						<div class="mt-3.5 flex flex-col gap-3">
							for _, org := range page.TopOrgs {
								<a href={ templ.SafeURL("/admin/orgs/" + org.ID) } class="block hover:no-underline">
									<div class="mb-1.5 flex justify-between">
										<span class="truncate text-sm text-text">{ org.Name }</span>
										<span class="font-mono text-[13px] text-text-3 tabular-nums">{ FormatCredits(org.Credits) }</span>
									</div>
									<div class="h-1.5 w-full overflow-hidden rounded-full bg-track">
										<div class="h-full rounded-full bg-brand" style={ templ.SafeCSS("width:" + itoa(org.Pct) + "%") }></div>
									</div>
								</a>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}
