package view

// ADM-05 — Canaux et plateformes : comptes de messagerie de l'instance
// (partagés par toutes les organisations), table des canaux, jetons de
// groupe, et le gabarit d'appairage à variantes. En lot A, go-courier
// n'expose pas d'état de connexion : les cartes affichent « Configurée »
// (état neutre, honnête) ; l'appairage à chaud arrive dans un prochain lot.

type PlatformCard struct {
	Type string
	Name string
	Chip Chip
	// Details : deux lignes descriptives (numéro masqué, nb de canaux…).
	Details []string
}

type ChannelRow struct {
	PlatformType string
	Name         string
	Kind         string
	OrgName      string
	Chip         Chip
	// TokenPrefix : préfixe du jeton pour une ligne « en attente de
	// liaison » (« atm_9K2P… »).
	TokenPrefix string
	RowTone     string
}

type PlatformsPage struct {
	Platforms []SidebarPlatform
	CSRFToken string

	Cards      []PlatformCard
	Channels   []ChannelRow
	Active     int
	PendingCnt int
	// Orgs alimente le sélecteur du jeton de groupe.
	Orgs []struct{ ID, Name string }
	// FlashToken : jeton de groupe fraîchement généré.
	FlashToken *TokenPanelData
	// Pairing ouvre le gabarit d'appairage avec la variante demandée :
	// "" (fermé) | "qr" | "credentials".
	Pairing string
}

templ channelsSummary(page PlatformsPage) {
	if page.PendingCnt > 0 {
		<span>{ itoa(page.Active) } canaux · { itoa(page.PendingCnt) } en attente de liaison</span>
	} else {
		<span>{ itoa(page.Active) } canaux</span>
	}
}

templ AdminPlatforms(page PlatformsPage) {
	@AdminLayout("Canaux et plateformes — Automata Admin", "platforms", page.Platforms, page.CSRFToken) {
		<header class="flex items-center border-b border-line-2 bg-white px-8 py-5">
			<div>
				<h1 class="text-[21px] font-semibold leading-tight tracking-[-.01em] text-ink">Canaux et plateformes</h1>
				<div class="mt-0.5 text-sm text-text-3">Comptes de messagerie de l'instance, partagés par toutes les organisations</div>
			</div>
			<a href="/admin/platforms?pairing=qr" class="ml-auto flex h-9 items-center rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-strong hover:no-underline">Ajouter un compte</a>
		</header>
		<div class="flex items-start gap-5.5 px-8 pb-8 pt-6">
			<div class="flex min-w-0 flex-1 flex-col gap-5.5">
				if page.FlashToken != nil {
					@TokenPanel(*page.FlashToken)
				}
				<div class="flex gap-3.5">
					for _, card := range page.Cards {
						<div class="flex-1 rounded-[11px] border border-line-2 bg-white p-4.5">
							<div class="mb-3 flex items-center gap-2">
								@PlatformBadge(card.Type, "size-6 rounded-[7px]", "text-[11px]")
								<span class="text-[15px] font-semibold text-ink">{ card.Name }</span>
							</div>
							@StatusChip(card.Chip)
							<div class="mt-3 text-[13px] leading-normal text-text-4">
								for i, line := range card.Details {
									if i > 0 {
										<br/>
									}
									{ line }
								}
							</div>
						</div>
					}
					<div class="flex w-[190px] shrink-0 flex-col justify-center gap-1.5 rounded-[11px] border border-dashed border-line p-4.5">
						<div class="text-sm font-semibold leading-snug text-text-4">Comptes dédiés par organisation</div>
						<div class="text-[13px] leading-snug text-text-5">Emplacement réservé — à venir</div>
					</div>
				</div>
				<div class="overflow-hidden rounded-[11px] border border-line-2 bg-white">
					<div class="flex items-center gap-3.5 border-b border-line-2 px-5 py-3.5">
						<div class="text-[15px] font-semibold text-ink">Canaux</div>
						<div class="text-[13px] text-text-4">
							@channelsSummary(page)
						</div>
						<form method="post" action="/admin/platforms/group-token" class="ml-auto flex shrink-0 items-center gap-2">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<select name="org_id" required class="h-8 rounded-lg border border-line bg-white px-2 text-[13px] outline-none focus:border-brand">
								<option value="">Organisation…</option>
								for _, org := range page.Orgs {
									<option value={ org.ID }>{ org.Name }</option>
								}
							</select>
							<button type="submit" class="h-8 whitespace-nowrap rounded-lg border border-line bg-white px-3 text-[13px] font-medium text-text hover:bg-panel">Générer un jeton de groupe</button>
						</form>
					</div>
					<div class="grid grid-cols-[1.4fr_.8fr_1.2fr_1.1fr] gap-4 border-b border-line-2 bg-panel px-5 py-2.5 font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">
						<div>Canal</div>
						<div>Type</div>
						<div>Organisation</div>
						<div>Liaison</div>
					</div>
					for _, row := range page.Channels {
						<div class={ "grid grid-cols-[1.4fr_.8fr_1.2fr_1.1fr] items-center gap-4 border-b border-line-3 px-5 py-3 last:border-b-0", orgRowToneClass(row.RowTone) }>
							<div class="flex items-center gap-2.5">
								@PlatformBadge(row.PlatformType, "size-5 rounded-md", "text-[9px]")
								<span class="truncate text-sm font-medium text-text">{ row.Name }</span>
							</div>
							<div class="text-sm text-text-3">{ row.Kind }</div>
							if row.OrgName != "" {
								<div class="truncate text-sm text-text">{ row.OrgName }</div>
							} else {
								<div class="text-sm text-text-4">—</div>
							}
							<div class="flex items-center gap-2.5">
								@StatusChip(row.Chip)
								if row.TokenPrefix != "" {
									<span class="font-mono text-xs text-text-4">{ row.TokenPrefix }</span>
								}
							</div>
						</div>
					}
				</div>
			</div>
			if page.Pairing != "" {
				@pairingPanel(page)
			}
		</div>
	}
}

templ pairingPlatformOption(page PlatformsPage, mode string, platformType string, label string) {
	{{ selected := (mode == "qr" && page.Pairing == "qr" && platformType == "whatsapp") || (mode == "credentials" && page.Pairing == "credentials" && platformType == "rocket") }}
	<a href={ templ.SafeURL("/admin/platforms?pairing=" + mode) } class={ "flex flex-1 flex-col items-center gap-1.5 rounded-[9px] border px-2 py-2 hover:no-underline", templ.KV("border-brand bg-brand-wash", selected), templ.KV("border-line-2", !selected) }>
		@PlatformBadge(platformType, "size-[22px] rounded-md", "text-[10px]")
		if selected {
			<span class="text-xs font-semibold text-brand-deep">{ label }</span>
		} else {
			<span class="text-xs font-medium text-text-2">{ label }</span>
		}
	</a>
}

// pairingPanel est le gabarit d'appairage : sélecteur de plateforme en
// haut, corps variable (QR / serveur + identifiants), même pied de page
// (annotation ADM-05). L'appairage réel arrive dans un prochain lot : la
// soumission l'explique.
templ pairingPanel(page PlatformsPage) {
	<div class="w-[396px] shrink-0 overflow-hidden rounded-xl border border-line bg-white shadow-[0_8px_24px_rgba(22,28,39,.1)]">
		<div class="flex items-center gap-2.5 border-b border-line-2 px-5 py-4">
			<div class="text-base font-semibold text-ink">Appairer un compte</div>
			<a href="/admin/platforms" class="ml-auto text-lg text-text-4 hover:no-underline">×</a>
		</div>
		<div class="p-5">
			<div class="mb-2 text-[13px] font-medium text-text-2">Plateforme</div>
			<div class="mb-5 flex gap-2">
				@pairingPlatformOption(page, "qr", "whatsapp", "WhatsApp")
				@pairingPlatformOption(page, "qr", "signal", "Signal")
				@pairingPlatformOption(page, "credentials", "rocket", "Rocket.Chat")
			</div>
			if page.Pairing == "credentials" {
				<div class="flex flex-col gap-3.5">
					<label class="block">
						<span class="mb-1.5 block text-[13px] font-medium text-text-2">Adresse du serveur</span>
						<input type="text" placeholder="chat.exemple.fr" class="h-[38px] w-full rounded-lg border border-line px-3 font-mono text-sm outline-none placeholder:text-text-5 focus:border-brand"/>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-[13px] font-medium text-text-2">Identifiant du bot</span>
						<input type="text" placeholder="automata" class="h-[38px] w-full rounded-lg border border-line px-3 text-sm outline-none placeholder:text-text-5 focus:border-brand"/>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-[13px] font-medium text-text-2">Jeton d'accès personnel</span>
						<input type="password" class="h-[38px] w-full rounded-lg border border-line px-3 font-mono text-sm outline-none focus:border-brand"/>
					</label>
					<div class="text-[13px] leading-normal text-text-4">Le secret est chiffré au repos et ne sera plus affiché après enregistrement.</div>
				</div>
			} else {
				<div class="flex flex-col items-center gap-3.5 py-1">
					<div class="flex size-[176px] items-center justify-center rounded-[10px] border border-line-2 bg-panel">
						<div class="text-center font-mono text-[11px] leading-relaxed text-text-4">QR code<br/>d'appairage</div>
					</div>
					<div class="max-w-[290px] text-center text-sm leading-normal text-text-3">Dans WhatsApp, ouvrez <span class="font-medium text-text">Appareils connectés</span> et scannez ce code. Il se renouvelle toutes les 20 secondes.</div>
					<div class="flex items-center gap-2">
						<span class="size-[7px] rounded-full bg-warn"></span>
						<span class="font-mono text-[13px] text-warn-deep">Prochain lot — appairage à chaud</span>
					</div>
				</div>
			}
			<div class="mt-5 flex gap-2.5 border-t border-line-3 pt-4">
				<a href="/admin/platforms" class="flex h-[38px] flex-1 items-center justify-center rounded-lg border border-line text-sm font-medium text-text hover:bg-panel hover:no-underline">Annuler</a>
				<span class="flex h-[38px] flex-1 cursor-not-allowed items-center justify-center rounded-lg bg-brand/50 text-sm font-semibold text-white" title="L'appairage à chaud des comptes arrive dans un prochain lot">Vérifier</span>
			</div>
		</div>
	</div>
}
