package view

// ADM-05 — Canaux et plateformes : comptes de messagerie de l'instance
// (partagés par toutes les organisations), table des canaux, jetons de
// groupe, et le gabarit d'appairage à variantes. En lot A, go-courier
// n'expose pas d'état de connexion : les cartes affichent « Configurée »
// (état neutre, honnête) ; l'appairage à chaud arrive dans un prochain lot.

type PlatformCard struct {
	ID   string
	Type string
	Name string
	Chip Chip
	// Details : deux lignes descriptives (nb de canaux, ancienneté de
	// l'état ou message d'erreur).
	Details []string
	// Enabled distingue un compte arrêté volontairement d'un compte en
	// panne : le premier se rallume d'un clic, le second demande un examen.
	Enabled bool
	// PairingQR est l'image du code à scanner, présente uniquement tant
	// que le compte attend son appairage.
	PairingQR string
}

type ChannelRow struct {
	PlatformType string
	Name         string
	Kind         string
	OrgName      string
	Chip         Chip
	// TokenPrefix : préfixe du jeton pour une ligne « en attente de
	// liaison » (« atm_9K2P… »).
	TokenPrefix string
	RowTone     string
}

type PlatformsPage struct {
	Platforms []SidebarPlatform
	CSRFToken string

	Cards      []PlatformCard
	Channels   []ChannelRow
	Active     int
	PendingCnt int
	// Orgs alimente le sélecteur du jeton de groupe.
	Orgs []struct{ ID, Name string }
	// FlashToken : jeton de groupe fraîchement généré.
	FlashToken *TokenPanelData
	// Pairing ouvre le gabarit d'appairage avec la variante demandée :
	// "" (fermé) | "qr" | "credentials". PairingPlatform est la plateforme
	// sélectionnée dans le gabarit (whatsapp, signal, rocket…).
	Pairing         string
	PairingPlatform string
	// Fields décrit les champs de configuration du type sélectionné.
	Fields []PlatformField
	Error  string
}

// PlatformField est un champ du formulaire d'ajout de compte.
type PlatformField struct {
	Name        string
	Label       string
	Placeholder string
	Secret      bool
	Required    bool
}

templ channelsSummary(page PlatformsPage) {
	if page.PendingCnt > 0 {
		<span>{ itoa(page.Active) } canaux · { itoa(page.PendingCnt) } en attente de liaison</span>
	} else {
		<span>{ itoa(page.Active) } canaux</span>
	}
}

templ AdminPlatforms(page PlatformsPage) {
	@AdminLayout("Canaux et plateformes — Automata Admin", "platforms", page.Platforms, page.CSRFToken) {
		<header class="flex items-center border-b border-line-2 bg-white px-8 py-5">
			<div>
				<h1 class="text-[21px] font-semibold leading-tight tracking-[-.01em] text-ink">Canaux et plateformes</h1>
				<div class="mt-0.5 text-sm text-text-3">Comptes de messagerie de l'instance, partagés par toutes les organisations</div>
			</div>
			<a href="/admin/platforms?pairing=qr" class="ml-auto flex h-9 items-center rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-strong hover:no-underline">Ajouter un compte</a>
		</header>
		<div class="flex items-start gap-5.5 px-8 pb-8 pt-6">
			<div class="flex min-w-0 flex-1 flex-col gap-5.5">
				if page.FlashToken != nil {
					@TokenPanel(*page.FlashToken)
				}
				<div class="flex flex-wrap gap-3.5">
					for _, card := range page.Cards {
						<div class={ "flex w-[240px] flex-col rounded-[11px] border bg-white p-4.5", templ.KV("border-warn", card.PairingQR != ""), templ.KV("border-line-2", card.PairingQR == "") }>
							<div class="mb-3 flex items-center gap-2">
								@PlatformBadge(card.Type, "size-6 rounded-[7px]", "text-[11px]")
								<span class="truncate text-[15px] font-semibold text-ink">{ card.Name }</span>
							</div>
							@StatusChip(card.Chip)
							<div class="mt-3 text-[13px] leading-normal text-text-4">
								for i, line := range card.Details {
									if i > 0 {
										<br/>
									}
									{ line }
								}
							</div>
							if card.PairingQR != "" {
								<div class="mt-3.5 flex flex-col items-center gap-2 rounded-[10px] border border-warn-line bg-warn-row p-3">
									<img src={ card.PairingQR } alt="Code d'appairage à scanner" class="size-[168px]"/>
									<div class="text-center text-[13px] leading-snug text-warn-deep">Scannez ce code depuis <span class="font-medium">Appareils connectés</span>. Il se renouvelle tout seul.</div>
								</div>
							}
							<div class="mt-3.5 flex gap-2 border-t border-line-3 pt-3">
								<form method="post" action={ templ.SafeURL("/admin/platforms/" + card.ID + "/toggle") } class="flex-1">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="enabled" value={ boolFlip(card.Enabled) }/>
									if card.Enabled {
										<button type="submit" class="h-8 w-full rounded-lg border border-line text-[13px] font-medium text-text hover:bg-panel">Arrêter</button>
									} else {
										<button type="submit" class="h-8 w-full rounded-lg bg-brand text-[13px] font-semibold text-white hover:bg-brand-strong">Démarrer</button>
									}
								</form>
								<form method="post" action={ templ.SafeURL("/admin/platforms/" + card.ID + "/delete") } onsubmit="return confirm('Retirer ce compte ? Sa session sur disque est conservée.')">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<button type="submit" class="h-8 rounded-lg border border-line px-3 text-[13px] font-medium text-crit hover:bg-crit-wash">Retirer</button>
								</form>
							</div>
						</div>
					}
					<div class="flex w-[190px] shrink-0 flex-col justify-center gap-1.5 rounded-[11px] border border-dashed border-line p-4.5">
						<div class="text-sm font-semibold leading-snug text-text-4">Comptes dédiés par organisation</div>
						<div class="text-[13px] leading-snug text-text-5">Emplacement réservé — à venir</div>
					</div>
				</div>
				<div class="overflow-hidden rounded-[11px] border border-line-2 bg-white">
					<div class="flex items-center gap-3.5 border-b border-line-2 px-5 py-3.5">
						<div class="text-[15px] font-semibold text-ink">Canaux</div>
						<div class="text-[13px] text-text-4">
							@channelsSummary(page)
						</div>
						<form method="post" action="/admin/platforms/group-token" class="ml-auto flex shrink-0 items-center gap-2">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<select name="org_id" required class="h-8 rounded-lg border border-line bg-white px-2 text-[13px] outline-none focus:border-brand">
								<option value="">Organisation…</option>
								for _, org := range page.Orgs {
									<option value={ org.ID }>{ org.Name }</option>
								}
							</select>
							<button type="submit" class="h-8 whitespace-nowrap rounded-lg border border-line bg-white px-3 text-[13px] font-medium text-text hover:bg-panel">Générer un jeton de groupe</button>
						</form>
					</div>
					<div class="grid grid-cols-[1.4fr_.8fr_1.2fr_1.1fr] gap-4 border-b border-line-2 bg-panel px-5 py-2.5 font-mono text-[10px] font-bold uppercase tracking-[.09em] text-text-4">
						<div>Canal</div>
						<div>Type</div>
						<div>Organisation</div>
						<div>Liaison</div>
					</div>
					for _, row := range page.Channels {
						<div class={ "grid grid-cols-[1.4fr_.8fr_1.2fr_1.1fr] items-center gap-4 border-b border-line-3 px-5 py-3 last:border-b-0", orgRowToneClass(row.RowTone) }>
							<div class="flex items-center gap-2.5">
								@PlatformBadge(row.PlatformType, "size-5 rounded-md", "text-[9px]")
								<span class="truncate text-sm font-medium text-text">{ row.Name }</span>
							</div>
							<div class="text-sm text-text-3">{ row.Kind }</div>
							if row.OrgName != "" {
								<div class="truncate text-sm text-text">{ row.OrgName }</div>
							} else {
								<div class="text-sm text-text-4">—</div>
							}
							<div class="flex items-center gap-2.5">
								@StatusChip(row.Chip)
								if row.TokenPrefix != "" {
									<span class="font-mono text-xs text-text-4">{ row.TokenPrefix }</span>
								}
							</div>
						</div>
					}
				</div>
			</div>
			if page.Pairing != "" {
				@pairingPanel(page)
			}
		</div>
	}
}

templ pairingPlatformOption(page PlatformsPage, mode string, platformType string, label string) {
	{{ selected := page.PairingPlatform == platformType }}
	<a href={ templ.SafeURL("/admin/platforms?pairing=" + mode + "&platform=" + platformType) } class={ "flex flex-1 flex-col items-center gap-1.5 rounded-[9px] border px-2 py-2 hover:no-underline", templ.KV("border-brand bg-brand-wash", selected), templ.KV("border-line-2", !selected) }>
		@PlatformBadge(platformType, "size-[22px] rounded-md", "text-[10px]")
		if selected {
			<span class="text-xs font-semibold text-brand-deep">{ label }</span>
		} else {
			<span class="text-xs font-medium text-text-2">{ label }</span>
		}
	</a>
}

// pairingPanel est le gabarit d'ajout de compte : sélecteur de plateforme
// en haut, champs propres au type en dessous, même pied de page
// (annotation ADM-05). Pour WhatsApp et Signal, l'appairage se poursuit sur
// la carte du compte, qui affiche le QR dès que le compte démarre.
templ pairingPanel(page PlatformsPage) {
	<div class="w-[396px] shrink-0 overflow-hidden rounded-xl border border-line bg-white shadow-[0_8px_24px_rgba(22,28,39,.1)]">
		<div class="flex items-center gap-2.5 border-b border-line-2 px-5 py-4">
			<div class="text-base font-semibold text-ink">Ajouter un compte</div>
			<a href="/admin/platforms" class="ml-auto text-lg text-text-4 hover:no-underline">×</a>
		</div>
		<form method="post" action="/admin/platforms" class="p-5">
			<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
			<input type="hidden" name="type" value={ page.PairingPlatform }/>
			<div class="mb-2 text-[13px] font-medium text-text-2">Plateforme</div>
			<div class="mb-5 flex gap-2">
				@pairingPlatformOption(page, "qr", "whatsapp", "WhatsApp")
				@pairingPlatformOption(page, "qr", "signal", "Signal")
				@pairingPlatformOption(page, "credentials", "rocket", "Rocket.Chat")
			</div>
			if page.Error != "" {
				<div class="mb-4 rounded-lg bg-crit-wash px-3 py-2.5 text-[13px] text-crit-deep">{ page.Error }</div>
			}
			<div class="flex flex-col gap-3.5">
				<label class="block">
					<span class="mb-1.5 block text-[13px] font-medium text-text-2">Nom du compte <span class="font-normal text-text-4">— sert d'identifiant</span></span>
					<input type="text" name="id" required placeholder={ page.PairingPlatform } class="h-[38px] w-full rounded-lg border border-line px-3 font-mono text-sm outline-none placeholder:text-text-5 focus:border-brand"/>
				</label>
				for _, field := range page.Fields {
					<label class="block">
						<span class="mb-1.5 block text-[13px] font-medium text-text-2">
							{ field.Label }
							if !field.Required {
								<span class="font-normal text-text-4">— facultatif</span>
							}
						</span>
						if field.Secret {
							<input type="password" name={ field.Name } required?={ field.Required } class="h-[38px] w-full rounded-lg border border-line px-3 font-mono text-sm outline-none focus:border-brand"/>
						} else {
							<input type="text" name={ field.Name } required?={ field.Required } placeholder={ field.Placeholder } class="h-[38px] w-full rounded-lg border border-line px-3 text-sm outline-none placeholder:text-text-5 focus:border-brand"/>
						}
					</label>
				}
				if page.Pairing == "qr" {
					<div class="rounded-lg bg-panel px-3 py-2.5 text-[13px] leading-normal text-text-3">Une fois le compte enregistré, sa carte affichera le QR code à scanner depuis { platformDisplayLabel(page.PairingPlatform) }.</div>
				} else {
					<div class="text-[13px] leading-normal text-text-4">Les secrets sont chiffrés au repos et ne seront plus affichés après enregistrement.</div>
				}
			</div>
			<div class="mt-5 flex gap-2.5 border-t border-line-3 pt-4">
				<a href="/admin/platforms" class="flex h-[38px] flex-1 items-center justify-center rounded-lg border border-line text-sm font-medium text-text hover:bg-panel hover:no-underline">Annuler</a>
				<button type="submit" class="h-[38px] flex-1 rounded-lg bg-brand text-sm font-semibold text-white hover:bg-brand-strong">Enregistrer</button>
			</div>
		</form>
	</div>
}

// platformDisplayLabel nomme une plateforme dans une phrase.
func platformDisplayLabel(platformType string) string {
	switch platformType {
	case "signal":
		return "Signal"
	case "rocket":
		return "Rocket.Chat"
	default:
		return "WhatsApp"
	}
}
