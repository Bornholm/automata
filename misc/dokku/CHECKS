# Vérifications de démarrage exécutées par Dokku avant de basculer le
# trafic vers le nouveau conteneur.
#
# La page de connexion de l'administration est la sonde la plus honnête :
# elle ne répond que si la configuration a été chargée, la base ouverte et
# les migrations appliquées. Une sonde plus creuse laisserait passer un
# conteneur qui démarre puis meurt sur une base illisible.
WAIT=8
TIMEOUT=30
ATTEMPTS=6

/admin/login    Automata
